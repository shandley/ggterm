{
  "name": "@ggterm/core",
  "version": "0.3.10",
  "description": "Grammar of Graphics primitive catalog — 65+ geoms, 73 scales, terminal and Vega-Lite backends, AI-composable PlotSpec",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ggterm": "dist/cli.js",
    "ggterm-plot": "dist/cli-plot.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "import": "./dist/cli.js"
    }
  },
  "scripts": {
    "build": "bun build ./src/index.ts ./src/cli.ts ./src/cli-plot.ts --outdir ./dist --target node && tsc --emitDeclarationOnly",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "grammar-of-graphics",
    "data-visualization",
    "visualization",
    "vega-lite",
    "terminal",
    "charts",
    "plotspec",
    "declarative",
    "ai-agent",
    "scatter-plot",
    "histogram"
  ],
  "author": "Scott Handley",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shandley/ggterm.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/shandley/ggterm#readme",
  "bugs": {
    "url": "https://github.com/shandley/ggterm/issues"
  },
  "peerDependencies": {},
  "devDependencies": {
    "typescript": "^5.3.0",
    "@types/bun": "^1.1.0"
  }
}
