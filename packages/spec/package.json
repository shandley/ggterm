{
  "name": "@ggterm/spec",
  "version": "0.1.0",
  "description": "Declarative PlotSpec for Grammar of Graphics visualization: types, 66 geometry builders, and a Vega-Lite converter. No rendering, no dependencies.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./geoms": {
      "types": "./dist/geoms/index.d.ts",
      "bun": "./src/geoms/index.ts",
      "import": "./dist/geoms/index.js"
    },
    "./positions": {
      "types": "./dist/positions/index.d.ts",
      "bun": "./src/positions/index.ts",
      "import": "./dist/positions/index.js"
    },
    "./export": {
      "types": "./dist/export/index.d.ts",
      "bun": "./src/export/index.ts",
      "import": "./dist/export/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "bun": "./src/*.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "grammar-of-graphics",
    "plotspec",
    "declarative",
    "vega-lite",
    "visualization"
  ],
  "author": "Scott Handley",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shandley/ggterm.git",
    "directory": "packages/spec"
  },
  "devDependencies": {
    "typescript": "^5.3.0"
  }
}
